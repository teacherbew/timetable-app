# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- Database ---
# Option A (local / docker-compose): fill these in, database.py will build
# the connection string from them automatically.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=timetable_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=timetable_db

# Option B (Render / any managed Postgres): Render sets DATABASE_URL for you
# automatically when you attach a Postgres instance to your web service — you
# usually don't need to set this by hand. If set, it takes priority over the
# POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Security ---
# Generate a real random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Seed data (used by `python -m app.seed`) ---
ADMIN_DEFAULT_PASSWORD=change-me-before-seeding
